# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb://localhost:27017/waitless_dev

# Frontend Client URL & CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# JWT Secrets & Expiration (Must be >= 32 characters in production)
JWT_ACCESS_SECRET=waitless_development_jwt_access_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=waitless_development_jwt_refresh_secret_key_minimum_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Cookie Security (lax, strict, none)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.waitless.com
COOKIE_PATH=/api/v1/auth

# Reverse Proxy (false, true, or number of hops e.g. 1)
TRUST_PROXY=false
